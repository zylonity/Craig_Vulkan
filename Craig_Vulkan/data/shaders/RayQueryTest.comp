#version 460
#extension GL_EXT_ray_query : require

//Ray query setup adapted from Sascha Willems' rayquery example (MIT) - https://github.com/SaschaWillems/Vulkan/tree/master/shaders/glsl/rayquery
//No ray tracing pipeline or shader binding table, just a compute shader asking the TLAS "did this ray hit anything"

layout(local_size_x = 64) in;

layout(push_constant) uniform QuerySettings {
    uint rayCount;
};

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;

//origin.w is tmin, direction.w is tmax, direction.xyz is normalised
struct Ray { vec4 origin; vec4 direction; };
layout(std430, set = 0, binding = 1) readonly buffer RayInputs { Ray rays[]; };
layout(std430, set = 0, binding = 2) writeonly buffer RayResults { uint blocked[]; };

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= rayCount) return;

    Ray ray = rays[index];
    rayQueryEXT query;
    //Opaque blockers, and we only care if anything's in the way so stop at the first hit
    rayQueryInitializeEXT(query, topLevelAS, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
        0xff, ray.origin.xyz, ray.origin.w, ray.direction.xyz, ray.direction.w);
    while (rayQueryProceedEXT(query)) {}

    blocked[index] = rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionTriangleEXT ? 1u : 0u;
}
